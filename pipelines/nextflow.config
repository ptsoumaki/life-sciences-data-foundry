// Pull environment values from shell so config and scripts share the same source of truth
params.environment    = System.getenv('ENVIRONMENT') ?: 'dev'
params.aws_region     = System.getenv('AWS_REGION') ?: 'eu-west-1'
params.aws_account_id = System.getenv('AWS_ACCOUNT_ID') ?: ''

// Align S3 bucket naming with Terraform (account-id prefixed when present)
params.raw_bucket       = System.getenv('RAW_DATA_BUCKET') ?: (params.aws_account_id ? "life-sciences-platform-raw-${params.aws_account_id}-${params.environment}" : "life-sciences-platform-raw-${params.environment}")
params.processed_bucket = System.getenv('PROCESSED_DATA_BUCKET') ?: (params.aws_account_id ? "life-sciences-platform-processed-${params.aws_account_id}-${params.environment}" : "life-sciences-platform-processed-${params.environment}")

manifest {
    name            = 'life-sciences-data-foundry-pipeline'
    author          = 'Vivi Tsoumaki'
    description     = 'Decoupled life sciences data foundry pipeline for enterprise R&D scale.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
}

process {
    container = 'biocontainers/fastqc:v0.11.9_cv8'
}

profiles {
    local_dev {
        process.executor = 'local'
        docker.enabled   = true
    }
    aws_batch {
        process.executor = 'awsbatch'
        process.queue    = "nextflow-job-queue-${params.environment}"
        aws.region       = params.aws_region
    }
}