// Pull environment values from the shell so both config and scripts share the same source of truth
params.environment = System.getenv('ENVIRONMENT')
params.aws_region   = System.getenv('AWS_REGION')

manifest {
    name            = 'multiomics-platform-blueprint-pipeline'
    author          = 'Technical Product Owner & Architect'
    description     = 'Decoupled multi-omics data foundry pipeline for enterprise R&D scale.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
}

profiles {
    local_dev {
        process.executor = 'local'
        docker.enabled   = true
        process {
            withName: 'FASTQC' { container = 'biocontainers/fastqc:v0.11.9_cv8' }
        }
    }
    aws_batch {
        process.executor = 'awsbatch'
        process.queue = "multiomics-ecs-cluster-${params.environment}"
        // prefer explicit AWS_REGION env var; fallback to eu-west-1 when missing
        aws.region = params.aws_region ?: 'eu-west-1'
    }
}