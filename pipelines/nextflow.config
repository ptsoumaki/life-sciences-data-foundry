// Pull environment values from shell so config and scripts share the same source of truth
params.environment = System.getenv('ENVIRONMENT') ?: 'dev'
params.aws_region   = System.getenv('AWS_REGION') ?: 'eu-west-1'

manifest {
    name            = 'life-sciences-platform-blueprint-pipeline'
    author          = 'Vivi Tsoumaki'
    description     = 'Decoupled life sciences data foundry pipeline for enterprise R&D scale.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
}

process {
    container = 'biocontainers/fastqc:v0.11.9_cv8'
}

profiles {
    local_dev {
        process.executor = 'local'
        docker.enabled   = true
    }
    aws_batch {
        process.executor = 'awsbatch'
        process.queue    = "nextflow-job-queue-${params.environment}"
        aws.region       = params.aws_region
    }
}