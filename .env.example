ENVIRONMENT=dev
AWS_REGION=eu-west-1

# ==============================================================================
# CONFIGURATION INSTRUCTIONS
# ==============================================================================
# Copy this file to a new file named '.env' in the root folder before running scripts.
# Both Nextflow and Terraform will read these values when exported in your shell.
#
# For Terraform: Use 'TF_VAR_environment' and 'TF_VAR_aws_region' variables.
# For Nextflow: Variables will be mapped via 'nextflow.config' profiles.
# ==============================================================================

# Phase 3/4 Target Tokens (Placeholder profiles for development)
DATABRICKS_HOST=https://<your-databricks-instance>.cloud.databricks.com
AZURE_OPENAI_ENDPOINT=https://<your-azure-endpoint>.openai.azure.com/