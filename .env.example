# ==============================================================================
# LIFE SCIENCES PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the repository root folder.
# 2. Update parameter values for your target deployment environment.
# 3. Source via 'scripts/bootstrap.sh' (POSIX) or 'scripts/bootstrap.ps1' (PowerShell).
# ==============================================================================

# Core Platform Environment Settings
ENVIRONMENT=dev
AWS_REGION=eu-west-1

# Optional Terraform Variable Overrides (Overridden by bootstrap scripts)
# TF_VAR_environment=dev
# TF_VAR_aws_region=eu-west-1

# Databricks Medallion & OMOP CDM Target Configuration
# Required when executing PySpark OMOP normalization against remote Databricks workspace
DATABRICKS_HOST=https://<your-databricks-instance>.cloud.databricks.com
DATABRICKS_TOKEN=dapi<your-databricks-access-token>

# Agentic AI Compliance Tier Configuration (LangGraph & MCP Server)
# Required when connecting LangGraph agents to Azure OpenAI LLM providers
AZURE_OPENAI_ENDPOINT=https://<your-azure-endpoint>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o