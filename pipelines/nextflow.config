// Pull environment values from shell so config and scripts share the same source of truth
params.environment    = System.getenv('ENVIRONMENT') ?: 'dev'
params.aws_region     = System.getenv('AWS_REGION') ?: 'eu-west-1'
params.aws_account_id = System.getenv('AWS_ACCOUNT_ID') ?: ''

// Align S3 bucket naming with Terraform (account-id prefixed when present)
params.raw_bucket       = System.getenv('RAW_DATA_BUCKET') ?: (params.aws_account_id ? "life-sciences-platform-raw-${params.aws_account_id}-${params.environment}" : "life-sciences-platform-raw-${params.environment}")
params.processed_bucket = System.getenv('PROCESSED_DATA_BUCKET') ?: (params.aws_account_id ? "life-sciences-platform-processed-${params.aws_account_id}-${params.environment}" : "life-sciences-platform-processed-${params.environment}")

// Multi-omics input and output configuration
params.raw_fastq        = System.getenv('RAW_FASTQ_PATH') ?: "s3://${params.raw_bucket}/*.fastq"
params.raw_vcf          = System.getenv('RAW_VCF_PATH') ?: "s3://${params.raw_bucket}/*.vcf"
params.outdir           = System.getenv('OUTDIR') ?: "s3://${params.processed_bucket}/multi_omics_out"
params.multiqc_dir      = "${params.outdir}/multiqc"
params.manifest_path    = "${params.outdir}/provenance_manifest.json"
params.data_mode        = System.getenv('DATA_MODE') ?: 'demo'
params.save_delta       = true
params.foundry_container = System.getenv('FOUNDRY_CONTAINER') ?: null

manifest {
    name            = 'life-sciences-data-foundry-pipeline'
    author          = 'Vivi Tsoumaki'
    description     = 'Enterprise GxP Nextflow DSL2 multi-omics normalization and OMOP CDM v5.4 ingestion pipeline.'
    mainScript      = 'multi_omics_omop.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '0.4.0'
}

process {
    // Default fallback container
    container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'

    // Pinned, immutable Biocontainers for each process
    withName: 'FASTQC' {
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    }
    withName: 'BCFTOOLS.*' {
        container = 'quay.io/biocontainers/bcftools:1.19--h8b25389_1'
    }
    withName: 'MULTIQC' {
        container = 'quay.io/biocontainers/multiqc:1.21--pyhdfd78af_0'
    }
    withName: 'OMOP_INGEST' {
        container = null
    }
    withName: 'PROVENANCE_MANIFEST' {
        container = null
    }
}

profiles {
    local_dev {
        process.executor     = 'local'
        docker.enabled       = true
        params.raw_fastq     = 'analytical-layer/data/*.fastq'
        params.raw_vcf       = 'analytical-layer/data/genomic_variants.vcf'
        params.outdir        = 'mock_data/out'
        params.multiqc_dir   = 'mock_data/out/multiqc'
        params.manifest_path = 'mock_data/out/provenance_manifest.json'
    }
    aws_batch {
        process.executor = 'awsbatch'
        process.queue    = "nextflow-job-queue-${params.environment}"
        aws.region       = params.aws_region
        process {
            withName: 'OMOP_INGEST|PROVENANCE_MANIFEST' {
                container = params.foundry_container ?: 'public.ecr.aws/amazonlinux/amazonlinux:2023'
            }
        }
    }
    test {
        process.executor     = 'local'
        docker.enabled       = false
        params.raw_fastq     = 'analytical-layer/data/*.fastq'
        params.raw_vcf       = 'analytical-layer/data/genomic_variants.vcf'
        params.outdir        = 'mock_data/test_out'
        params.multiqc_dir   = 'mock_data/test_out/multiqc'
        params.manifest_path = 'mock_data/test_out/provenance_manifest.json'
    }
}